MONGODB_URI="mongodb://localhost:27019/database"

WEB_URI="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""  # obrigatório; gere com: openssl rand -base64 32 (diferente de ENCRYPTION_KEY)

ENCRYPTION_KEY=""

EMAIL="no-replay@example.com"
# SMTP (Amazon SES). SMTP_USER/SMTP_PASS são as credenciais SMTP do SES, não a access key do IAM.
# EMAIL precisa ser uma identidade verificada no SES (e a conta fora do sandbox para destinos externos).
SMTP_HOST="email-smtp.us-east-1.amazonaws.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

MYAPP="Base Project"

NEXT_PUBLIC_RECAPTCHA_SITE_KEY=""
RECAPTCHA_SECRET_KEY=""

# --- Dokploy ---
# Domínio/porta/liga-desliga são configurados no SABLIER_SERVICES do projeto "sabiler":
# [{"name":"nextjs-base","services":["nextjs-base"],"domain":"app.example.com","port":3000,"idle":"15m","title":"Base"}]
